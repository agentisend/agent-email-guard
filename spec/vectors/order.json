{
  "$schema": "./vector.schema.json",
  "name": "order",
  "description": "The fixed check order: kill switch, suppression, loop, approval, rate, budgets.",
  "source": "oss/agent-guard/spec/SPEC.md §7",
  "cases": [
    {
      "name": "loop outranks approval and budgets",
      "config": {
        "approval": {
          "recipients": [
            "victim@example.com"
          ]
        },
        "budgets": {
          "per_hour": 0
        }
      },
      "steps": [
        {
          "op": "record",
          "at": 1799999999970,
          "send": {
            "to": "victim@example.com",
            "subject": "Quick question about your roadmap",
            "text": "Hi, I wanted to follow up on my last note about your Q3 roadmap. Any interest?"
          },
          "repeat": 3,
          "every_ms": 10
        },
        {
          "op": "check",
          "at": 1800000000000,
          "send": {
            "to": "victim@example.com",
            "subject": "Quick question about your roadmap",
            "text": "Hi, I wanted to follow up on my last note about your Q3 roadmap. Any interest?"
          },
          "expect": {
            "outcome": "refuse",
            "reason": "loop_repetition_detected",
            "message": "Blocked: 3 near-identical emails already went to victim@example.com within 60 minutes, which matches a retry or script loop; review the agent before sending more.",
            "evidence": {
              "signal_repetition": true,
              "signal_entropy": false,
              "matching_sends_in_window": 3,
              "repetition_threshold": 3,
              "closest_subject_similarity": 1,
              "closest_body_similarity": 1,
              "window_size": 3,
              "distinct_recipients": 1,
              "entropy_bits": 0,
              "effective_recipients": 1,
              "perplexity_floor": 3,
              "candidate_recipient_share": 1,
              "dominant_share_floor": 0.333,
              "window_ms": 3600000
            }
          }
        }
      ]
    },
    {
      "name": "approval outranks rate and budgets",
      "config": {
        "approval": {
          "recipients": [
            "@example.com"
          ]
        },
        "budgets": {
          "per_hour": 0
        },
        "rate": {
          "per_minute": 1
        },
        "loop": {
          "mode": "off"
        }
      },
      "steps": [
        {
          "op": "check",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "Hi",
            "text": "x"
          },
          "expect": {
            "outcome": "hold_for_approval",
            "reason": "recipient_requires_approval",
            "message": "a@example.com matches the approval rule @example.com, so this email waits for a person to approve it.",
            "evidence": {
              "rule": "recipient_list",
              "recipient": "a@example.com",
              "matched_rule": "@example.com"
            }
          }
        }
      ]
    },
    {
      "name": "rate outranks budgets",
      "config": {
        "budgets": {
          "per_hour": 1
        },
        "rate": {
          "per_minute": 1
        },
        "loop": {
          "mode": "off"
        }
      },
      "steps": [
        {
          "op": "send",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "1",
            "text": "x"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "rate_used": 1,
              "rate_ceiling": 1,
              "hour_used": 1,
              "hour_budget": 1
            }
          }
        },
        {
          "op": "send",
          "at": 1800000000001,
          "send": {
            "to": "a@example.com",
            "subject": "2",
            "text": "x"
          },
          "expect": {
            "outcome": "refuse",
            "reason": "rate_ceiling_exceeded",
            "message": "Key \"default\" reached its ceiling of 1 send per minute; wait 60 seconds and try again.",
            "evidence": {
              "key": "default",
              "sends_in_window": 1,
              "ceiling_per_minute": 1,
              "retry_after_seconds": 60
            }
          }
        }
      ]
    },
    {
      "name": "an empty config allows and reports the loop window",
      "config": {},
      "steps": [
        {
          "op": "send",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "Hi",
            "text": "x"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "window_size": 0,
              "distinct_recipients": 0,
              "entropy_bits": 0,
              "effective_recipients": 1
            }
          }
        },
        {
          "op": "send",
          "at": 1800000000001,
          "send": {
            "to": "b@example.com",
            "subject": "Hi",
            "html": "<p>x</p>"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "window_size": 1,
              "distinct_recipients": 1,
              "entropy_bits": 0,
              "effective_recipients": 1
            }
          }
        }
      ]
    },
    {
      "name": "an empty text falls back to html",
      "description": "The body is text when it is non-empty, else html. Three sends whose text is empty and whose html matches are a repetition loop.",
      "config": {},
      "steps": [
        {
          "op": "record",
          "at": 1799999997000,
          "send": {
            "to": "a@example.com",
            "subject": "Hi",
            "text": "",
            "html": "<p>Your code is 1234</p>"
          },
          "repeat": 3,
          "every_ms": 1000
        },
        {
          "op": "check",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "Hi",
            "text": "",
            "html": "<p>Your code is 1234</p>"
          },
          "expect": {
            "outcome": "refuse",
            "reason": "loop_repetition_detected",
            "message": "Blocked: 3 near-identical emails already went to a@example.com within 60 minutes, which matches a retry or script loop; review the agent before sending more.",
            "evidence": {
              "signal_repetition": true,
              "signal_entropy": false,
              "matching_sends_in_window": 3,
              "repetition_threshold": 3,
              "closest_subject_similarity": 1,
              "closest_body_similarity": 1,
              "window_size": 3,
              "distinct_recipients": 1,
              "entropy_bits": 0,
              "effective_recipients": 1,
              "perplexity_floor": 3,
              "candidate_recipient_share": 1,
              "dominant_share_floor": 0.333,
              "window_ms": 3600000
            }
          }
        },
        {
          "op": "check",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "Hi",
            "text": "A completely different plain body.",
            "html": "<p>Your code is 1234</p>"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "window_size": 3,
              "distinct_recipients": 1,
              "entropy_bits": 0,
              "effective_recipients": 1
            }
          }
        }
      ]
    }
  ]
}
