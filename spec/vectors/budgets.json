    {
      "name": "release() after a provider failure gives the budget back",
      "config": {
        "budgets": {
          "per_hour": 1
        },
        "loop": {
          "mode": "off"
        }
      },
      "steps": [
        {
          "op": "check",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "1",
            "text": "provider will fail"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "hour_used": 1,
              "hour_budget": 1
            }
          }
        },
        {
          "op": "release",
          "at": 1800000000001,
          "step": 0
        },
        {
          "op": "release",
          "at": 1800000000002,
          "step": 0,
          "note": "a second release changes nothing"
        },
        {
          "op": "send",
          "at": 1800000000003,
          "send": {
            "to": "a@example.com",
            "subject": "1",
            "text": "retry"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "hour_used": 1,
              "hour_budget": 1
            }
          }
        },
        {
          "op": "send",
          "at": 1800000000004,
          "send": {
            "to": "a@example.com",
            "subject": "2",
            "text": "over"
          },
          "expect": {
            "outcome": "refuse",
            "reason": "agent_budget_exceeded",
            "message": "Key \"default\" has used its hourly budget of 1 email; it resets at 2027-01-15T09:00:00Z.",
            "evidence": {
              "key": "default",
              "period": "hour",
              "budget": 1,
              "used": 1,
              "resets_at": 1800003600000
            }
          }
        }
      ]
    },
