{
  "$schema": "./vector.schema.json",
  "name": "budgets",
  "description": "Hourly, daily and monthly budgets per key, counted in UTC calendar periods; check() reserves, release() gives back.",
  "source": "packages/agent-guard/test/b08-budget-race.test.ts",
  "cases": [
    {
      "name": "the third send in an hour with a budget of 2 is refused; the next hour opens",
      "config": {
        "budgets": {
          "per_hour": 2
        },
        "loop": {
          "mode": "off"
        }
      },
      "steps": [
        {
          "op": "send",
          "at": 1800000000000,
          "send": {
            "to": "a@example.com",
            "subject": "1",
            "text": "one"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "hour_used": 1,
              "hour_budget": 2
            }
          }
        },
        {
          "op": "send",
          "at": 1800000001000,
          "send": {
            "to": "b@example.com",
            "subject": "2",
            "text": "two"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "hour_used": 2,
              "hour_budget": 2
            }
          }
        },
        {
          "op": "send",
          "at": 1800000002000,
          "send": {
            "to": "c@example.com",
            "subject": "3",
            "text": "three"
          },
          "expect": {
            "outcome": "refuse",
            "reason": "agent_budget_exceeded",
            "message": "Key \"default\" has used its hourly budget of 2 emails; it resets at 2027-01-15T09:00:00Z.",
            "evidence": {
              "key": "default",
              "period": "hour",
              "budget": 2,
              "used": 2,
              "resets_at": 1800003600000
            }
          }
        },
        {
          "op": "send",
          "at": 1800003600000,
          "send": {
            "to": "c@example.com",
            "subject": "3",
            "text": "three"
          },
          "expect": {
            "outcome": "allow",
            "reason": "ok",
            "message": "No limit, loop or approval rule blocks this send.",
            "evidence": {
              "key": "default",
              "hour_used": 1,
              "hour_budget": 2
            }
          }
        }
      ]
    },
