{
  "name": "agent-email-guard-proxy",
  "version": "0.1.0",
  "description": "Local HTTP proxy that checks each Resend-shaped send against agent-email-guard and forwards an allowed request unchanged.",
  "license": "MIT",
  "author": "AgentiSend <hello@agentisend.com>",
  "homepage": "https://github.com/agentisend/agent-email-guard/tree/main/resend-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentisend/agent-email-guard.git",
    "directory": "resend-proxy"
  },
  "bugs": {
    "url": "https://github.com/agentisend/agent-email-guard/issues"
  },
  "keywords": [
    "ai-agents",
    "email",
    "guardrails",
    "rate-limit",
    "budget",
    "resend"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-email-guard-proxy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "agent-email-guard": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.22.0"
}
